<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);">4.30%</td>
<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);">\$0</td>
<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);">\$0</td>
</tr>
<tr>
<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);"><strong>Discover Online Savings</strong></td>
<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);">4.25%</td>
<td style="padding: 0.75rem; border-bottom: 1px solid var(--color-border-light);">\$0</td>
